# Build the API image from an explicit runtime allow-list.  This prevents local
# credentials, VCS history, virtualenvs, test captures, logs and generated
# analysis artefacts from ever entering the Docker build context.
**

!Dockerfile
!requirements.txt
!main.py
!LICENSE
!THIRD_PARTY_NOTICES.md
!LICENSES/
!LICENSES/EUPL-1.2.txt

!docs/
!docs/VECTO_SSM_PROVENANCE.md
!docs/VECTO_HVAC_TEMPLATES.md
!docs/FEATURE_EXTRACTION_CONTRACT.md
!docs/PRODUCTION_FEATURE_V2.md

!app/
!app/**

!simulation/
!simulation/*.py

!elettra_core/
!elettra_core/*.py
!elettra_core/data/
!elettra_core/data/vecto_hvac_5_1_3_r744_templates_v1.json

!config/
!config/elettra-config.docker.yaml
!config/economic_defaults.json
!config/emission_defaults.json

# Re-exclude generated bytecode beneath explicitly included packages.
**/__pycache__/
**/*.py[cod]
